#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;
int main() {
    int chain[3][5][10], occupiedTotal = 0;
    srand(static_cast<unsigned>(time(nullptr)));
    for (int branch = 0; branch < 3; ++branch)
        for (int floor = 0; floor < 5; ++floor)
            for (int room = 0; room < 10; ++room) {
                chain[branch][floor][room] = rand() % 2;
                occupiedTotal += chain[branch][floor][room];
            }
    cout << "Occupied rooms across all branches: " << occupiedTotal << '\n';
}
